# Public, inlined at build time (put real values in .env.local / CI build env).
# Base URL without trailing slash — used for canonicals, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=
# TreatVero WhatsApp Business number, digits only with country code (e.g. 919800000000).
# Leave empty to open WhatsApp without a preset recipient.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional public contact email shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=
# Cloudflare Turnstile site key (public). Empty in development = Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side configuration lives in Cloudflare, not here:
#   - D1 (DB), R2 (REPORTS) and rate limiters → wrangler.jsonc
#   - PAYMENTS_PROVIDER → "vars" in wrangler.jsonc ("manual" or "stripe")
#   - STRIPE_SECRET_KEY → `npx wrangler secret put STRIPE_SECRET_KEY` (never commit it)
#   - TURNSTILE_SECRET, SESSION_SECRET, RESEND_API_KEY → `npx wrangler secret put <NAME>` (see .dev.vars.example)
