{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "treatvero",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// Workers Custom Domains on the treatvero.com zone (same Cloudflare account).
	// Deploy creates the DNS records and certificates; www 301s to the apex in next.config.ts.
	"workers_dev": false,
	"routes": [
		{ "pattern": "treatvero.com", "custom_domain": true },
		{ "pattern": "www.treatvero.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "treatvero"
		}
	],
	"images": {
		// Image optimization for next/image — see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},

	// Treatment requests. Schema lives in ./migrations
	// (apply with `npx wrangler d1 migrations apply treatvero --remote`).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "treatvero",
			"database_id": "71e1a1da-bd8a-4bdd-b78d-4a9ea5b1d90e",
			"migrations_dir": "migrations"
		}
	],

	// Private medical reports. Never attach a public r2.dev domain or custom
	// domain to this bucket — files are only reachable through the Worker.
	"r2_buckets": [
		{
			"binding": "REPORTS",
			"bucket_name": "treatvero-reports"
		}
	],

	// Workers Rate Limiting (per-location counters; periods must be 10 or 60 seconds).
	"ratelimits": [
		{ "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "UPLOAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "SESSION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
	],


	// Secrets (never here): TURNSTILE_SECRET, SESSION_SECRET, RESEND_API_KEY — `npx wrangler secret put <NAME>`.
	"vars": {
		"PAYMENTS_PROVIDER": "manual",
		// New-enquiry alerts (sent with Resend). Comma-separated recipients; alerts carry no patient details.
		"ENQUIRY_ALERT_TO": "hello@treatvero.com",
		"ENQUIRY_ALERT_FROM": "alerts@treatvero.com",
		// Cloudflare Access protecting the admin path (lib/admin/path.ts).
		// Team domain, e.g. "treatvero.cloudflareaccess.com", and the application's AUD tag.
		// The admin denies everyone until both are set.
		"CF_ACCESS_TEAM_DOMAIN": "quiet-bar-ac59.cloudflareaccess.com",
		"CF_ACCESS_AUD": "ac98b0ba6d1cd7cf2f5ea0ebf97767f2897f5450f730c67ea120086ffed58e02"
	},

	"observability": { "enabled": true },

	// Worker Previews (non-production branches, deployed by Workers Builds with
	// `wrangler preview`). Bindings aren't inherited, and previews use their own
	// D1 database and R2 bucket so preview URLs never touch patient data.
	// `wrangler d1 migrations apply` only reads top-level bindings: apply to
	// treatvero-preview with a temporary --config that lists it (see README).
	// Secrets aren't set for previews, so the enquiry form won't submit there;
	// alerts are skipped without RESEND_API_KEY, and the admin denies everyone
	// (preview URLs aren't behind Cloudflare Access).
	"previews": {
		"vars": {
			"PAYMENTS_PROVIDER": "manual",
			"ENQUIRY_ALERT_TO": "hello@treatvero.com",
			"ENQUIRY_ALERT_FROM": "alerts@treatvero.com",
			"CF_ACCESS_TEAM_DOMAIN": "quiet-bar-ac59.cloudflareaccess.com",
			"CF_ACCESS_AUD": "ac98b0ba6d1cd7cf2f5ea0ebf97767f2897f5450f730c67ea120086ffed58e02"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "treatvero-preview",
				"database_id": "d5fdf779-db97-493b-850b-c7de824eb0de",
				"migrations_dir": "migrations"
			}
		],
		"r2_buckets": [
			{
				"binding": "REPORTS",
				"bucket_name": "treatvero-reports-preview"
			}
		],
		"ratelimits": [
			{ "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
			{ "name": "UPLOAD_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
			{ "name": "SESSION_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } }
		],
		"images": {
			"binding": "IMAGES"
		}
	}
}
